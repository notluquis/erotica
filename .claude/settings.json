{
  "permissions": {
    "allow": [
      "mcp__codegraph__*"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "codegraph prompt-hook"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f .claude/hooks/guard_destructive.py ]; then python3 .claude/hooks/guard_destructive.py; else exit 0; fi",
            "timeout": 10,
            "statusMessage": "Revisando si el comando borra trabajo"
          }
        ]
      }
    ]
  }
}
