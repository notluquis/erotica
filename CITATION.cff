#
# Licence: AGPL-3.0-or-later, consistent across LICENSE, pyproject.toml and this
# file — verified 2026-08-02. (The earlier note here claiming LICENSE held GPL-3.0
# text was stale; it holds the AGPL, 661 lines with the network-server preamble.)
# GitHub'"'"'s licensee still *displays* GPL-3.0, which is a detection artefact and
# is tracked as an issue, not a licensing inconsistency.
cff-version: 1.2.0
message: "If you use EROTICA, please cite it using these metadata."
title: "EROTICA: Estimation, Recovery & Optimization, together with Inference, for Cluster Analysis"
abstract: >-
  An integrated, calibrated Bayesian Python pipeline for identifying and
  characterizing open clusters in Gaia data: HDBSCAN pseudo-probability
  membership with Bayesian PM/parallax refinement, Bayesian King structural
  fitting, NUTS Poisson-Hess isochrone fitting, and dynamical diagnostics,
  with ArviZ InferenceData provenance for every fit.
type: software
authors:
  # TODO: confirm final list + ORDER + ORCIDs before release. Affiliation confirmed (UdeC).
  - family-names: "Pulgar-Escobar"
    given-names: "Lucas"
    affiliation: "Universidad de Concepción, Chile"
    orcid: "https://orcid.org/0000-0000-0000-0000"  # TODO
  - family-names: "Henríquez Salgado"
    given-names: "Nicolás"
    affiliation: "Universidad de Concepción, Chile"
    orcid: "https://orcid.org/0000-0000-0000-0000"  # TODO
repository-code: "https://github.com/notluquis/erotica"
license: AGPL-3.0-or-later
version: 0.0.1
date-released: "2026-07-19"
