#   meta: !!omap
#   - {ucd: phys.angSize;instr.plate}
# - {name: r_i, datatype: float64}
# - {name: r_Ha, datatype: float64}
# - {name: EWHa, datatype: float64}
# - {name: excess, datatype: float64}
# - {name: EW_threshold, datatype: float64}
# - {name: is_CTTS, datatype: bool}
# - {name: track_extrapolated, datatype: bool}
