#   description: Unique VPHAS source identifier in the format field-extension-number (sourceID)
#   meta: !!omap
#   - {ucd: meta.id}
#   - {_votable_string_dtype: char}
#   - {_votable_arraysize: '*'}
#   subtype: json
# - name: RAJ2000
#   unit: deg
#   datatype: float64
#   description: Right Ascension in decimal degrees (J2000) (RAJ2000)
#   meta: !!omap
#   - {ucd: pos.eq.ra;meta.main}
# - name: DEJ2000
#   unit: deg
#   datatype: float64
#   description: Declination in decimal degrees (J2000) (DEJ2000)
#   meta: !!omap
#   - {ucd: pos.eq.dec;meta.main}
# - name: rmag
#   unit: mag
#   datatype: float32
#   description: '? Default r-band VEGA magnitude obtained using PSF fitting (r)'
#   meta: !!omap
#   - {ucd: phot.mag;em.opt.R}
# - name: e_rmag
#   unit: mag
#   datatype: float32
#   description: '? Statistical uncertainty for r, not including systematics (err_r)'
#   meta: !!omap
#   - {ucd: stat.error;phot.mag}
# - name: imag
#   unit: mag
#   datatype: float32
#   description: '? Default i-band VEGA magnitude obtained using PSF fitting (i)'
#   meta: !!omap
#   - {ucd: phot.mag;em.opt.I}
# - name: e_imag
#   unit: mag
#   datatype: float32
#   description: '? Statistical uncertainty for i, not including systematics (err_i)'
#   meta: !!omap
#   - {ucd: stat.error;phot.mag}
# - name: Hamag
#   unit: mag
#   datatype: float32
#   description: '? Default H-alpha VEGA magnitude obtained using PSF fitting (ha)'
#   meta: !!omap
#   - {ucd: phot.flux;em.line.Halpha}
# - name: e_Hamag
#   unit: mag
#   datatype: float32
#   description: '? Statistical uncertainty for ha, not including systematics (err_ha)'
#   meta: !!omap
#   - {ucd: stat.error;phot.mag}
# - name: r2mag
#   unit: mag
#   datatype: float32
#   description: '? Second r-band VEGA magnitude obtained using PSF fitting (r2)'
#   meta: !!omap
#   - {ucd: phot.mag;em.opt.R}
# - name: gmag
#   unit: mag
#   datatype: float32
#   description: '? Default g-band VEGA magnitude obtained using PSF fitting (g)'
#   meta: !!omap
#   - {ucd: phot.mag;em.opt.B}
# - name: umag
#   unit: mag
#   datatype: float32
#   description: '? Default u-band VEGA magnitude obtained using PSF fitting (u)'
#   meta: !!omap
#   - {ucd: phot.mag;em.opt.U}
# - name: Nobs
#   datatype: int16
#   description: '[1-6] Number of observations of this source in the survey (nObs)'
#   meta: !!omap
#   - {ucd: meta.number}
# - name: clean
#   datatype: int16
#   description: '[0/1] =1 if cleang, cleanr2, cleanha, cleanr and cleani are true (clean)'
#   meta: !!omap
#   - {ucd: meta.code}
# - name: Field
#   datatype: string
#   description: Survey-specific identifier of the telescope pointing (field)
#   meta: !!omap
#   - {ucd: meta.id;instr.tel}
#   - {_votable_string_dtype: char}
#   - {_votable_arraysize: '*'}
#   subtype: json
# - name: Ext
