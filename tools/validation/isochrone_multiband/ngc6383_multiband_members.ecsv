# %ECSV 1.0
# ---
# datatype:
# - name: source_id
#   datatype: int64
#   description: Unique source identifier. Note that this *cannot* be matched against the DR1 or DR2 source_ids.
#   meta: !!omap
#   - {ucd: meta.id;meta.main}
# - name: ra
#   unit: deg
#   datatype: float64
#   description: 'J2000 right ascension with respect to the 2MASS PSC reference frame from the non-moving source extraction. The sky coverage
#     depth for sources in the AllWISE Catalog is approximately twice as large in W1 and W2 as it is in W3 and W4. AllWISE combined W1
#     and W2 Single-exposure images from the WISE 4-Band Cryo, 3-Band Cryo and NEOWISE Post-Cryo survey phases, and W3 and W4 images from
#     the 4-Band Cryo phase only. The additional epoch of W1 and W2 coverage accenuates the weight of those two bands in determining source
#     properties such as position and motion. '
#   meta: !!omap
#   - {ucd: pos.eq.ra;meta.main}
#   - {utype: Char.SpatialAxis.Coverage.Location.Coord.Position2D.Value2.C1}
# - name: dec
#   unit: deg
#   datatype: float64
#   description: 'J2000 declination with respect to the 2MASS PSC reference frame from the non-moving source extraction. The sky coverage
#     depth for sources in the AllWISE Catalog is approximately twice as large in W1 and W2 as it is in W3 and W4. AllWISE combined W1
#     and W2 Single-exposure images from the WISE 4-Band Cryo, 3-Band Cryo and NEOWISE Post-Cryo survey phases, and W3 and W4 images from
#     the 4-Band Cryo phase only. The additional epoch of W1 and W2 coverage accenuates the weight of those two bands in determining source
#     properties such as position and motion. '
#   meta: !!omap
#   - {ucd: pos.eq.dec;meta.main}
#   - {utype: Char.SpatialAxis.Coverage.Location.Coord.Position2D.Value2.C2}
# - name: Gmag
#   unit: mag
#   datatype: float32
#   description: G-band mean magnitude
#   meta: !!omap
#   - {ucd: phot.mag;em.opt}
# - name: G_BPmag
#   unit: mag
#   datatype: float32
#   description: Integrated BP mean magnitude
#   meta: !!omap
#   - {ucd: phot.mag;em.opt.B}
# - name: G_RPmag
#   unit: mag
#   datatype: float32
#   description: Integrated RP mean magnitude
#   meta: !!omap
#   - {ucd: phot.mag;em.opt.R}
# - {name: e_Gmag, unit: mag, datatype: float64}
# - {name: e_G_BPmag, unit: mag, datatype: float64}
