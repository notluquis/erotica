#   unit: mas
#   datatype: float32
#   description: Standard error of parallax
#   meta: !!omap
#   - {ucd: stat.error;pos.parallax.trig}
# - {name: J_fit, datatype: float64}
# - {name: eJ_fit, datatype: float64}
# - {name: src_J, datatype: string}
# - {name: H_fit, datatype: float64}
