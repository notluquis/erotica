# %ECSV 1.0
# ---
# datatype:
# - name: source_id
#   datatype: int64
#   description: Gaia EDR3 unique source identifier
#   meta: !!omap
#   - {ucd: meta.id;meta.main;meta.ref}
# - name: Gmag
#   unit: mag
#   datatype: float64
#   description: '? G-band mean magnitude (phot_g_mean_mag)'
#   meta: !!omap
#   - {ucd: phot.mag;em.opt}
# - name: e_Gmag
#   unit: mag
#   datatype: float64
#   description: '? Error on G-band mean magnitude (added by CDS) (phot_g_mean_mag_error)'
#   meta: !!omap
#   - {ucd: stat.error;phot.mag;stat.mean}
# - name: BPmag
#   unit: mag
#   datatype: float64
#   description: '? Integrated BP mean magnitude (phot_bp_mean_mag)'
#   meta: !!omap
#   - {ucd: phot.mag;em.opt.B}
# - name: e_BPmag
#   unit: mag
#   datatype: float64
#   description: '? Error on integrated BP mean magnitude (added by CDS) (phot_bp_mean_mag_error)'
#   meta: !!omap
#   - {ucd: stat.error;phot.mag;stat.mean}
# - name: RPmag
#   unit: mag
#   datatype: float64
#   description: '? Integrated RP mean magnitude (phot_rp_mean_mag)'
#   meta: !!omap
#   - {ucd: phot.mag;em.opt.R}
# - name: e_RPmag
#   unit: mag
#   datatype: float64
#   description: '? Error on integrated RP mean magnitude (added by CDS) (phot_rp_mean_mag_error)'
#   meta: !!omap
#   - {ucd: stat.error;phot.mag;stat.mean}
# - name: E(BP/RP)
#   unit: mag
#   datatype: float64
#   description: '? BP/RP excess factor (phot_bp_rp_excess_factor)'
#   meta: !!omap
#   - {ucd: arith.factor;phot.flux;em.opt}
# - name: NBPblend
#   datatype: int16
#   description: '? Number of BP blended transits (phot_bp_n_blended_transits)'
#   meta: !!omap
#   - {ucd: meta.number}
# - name: NRPblend
#   datatype: int16
#   description: '? Number of RP contaminated transits (phot_rp_n_blended_transits)'
#   meta: !!omap
#   - {ucd: meta.number}
# - name: RUWE
#   datatype: float32
#   description: '? Renormalised unit weight error (ruwe)'
#   meta: !!omap
#   - {ucd: stat.error}
# - name: XPcont
#   datatype: int16
#   description: '[0/1] Flag indicating the availability of mean BP/RP spectrum in continuous representation for this source (has_xp_continuous)'
#   meta: !!omap
#   - {ucd: meta.code.status}
# - name: nueff
#   unit: um**-1
#   datatype: float32
#   description: '? Effective wavenumber of the source used in the astrometric solution (nu_eff_used_in_astrometry)'
#   meta: !!omap
#   - {ucd: em.wavenumber}
# - name: pscol
#   unit: um**-1
#   datatype: float32
#   description: '? Astrometrically estimated pseudocolour of the source (pseudocolour)'
#   meta: !!omap
#   - {ucd: em.wavenumber}
# - name: Solved
#   datatype: int16
#   description: '[3/95] Which parameters have been solved for? (astrometric_params_solved) (1)'
#   meta: !!omap
#   - {ucd: meta.number}
# - name: Plx
#   unit: mas
#   datatype: float64
#   description: '? Parallax (parallax)'
#   meta: !!omap
#   - {ucd: pos.parallax.trig}
# - name: e_Plx
#   unit: mas
#   datatype: float32
#   description: '? Standard error of parallax (parallax_error)'
#   meta: !!omap
#   - {ucd: stat.error;pos.parallax.trig}
# - name: ap_Teff
#   unit: K
#   datatype: float64
#   description: '? Effective temperature from GSP-Phot Aeneas best library using BP/RP spectra (teff_gspphot)'
#   meta: !!omap
#   - {ucd: phys.temperature.effective}
# - name: ap_b_Teff
#   unit: K
#   datatype: float64
#   description: '? Lower confidence level (16%) of effective temperature from GSP-Phot Aeneas best library using BP/RP spectra (teff_gspphot_lower)'
#   meta: !!omap
#   - {ucd: stat.value;phys.temperature.effective;stat.min}
# - name: ap_B_Teff
#   unit: K
#   datatype: float64
#   description: '? Upper confidence level (84%) of effective temperature from GSP-Phot Aeneas best library using BP/RP spectra (teff_gspphot_upper)'
#   meta: !!omap
#   - {ucd: stat.value;phys.temperature.effective;stat.max}
# - name: ap_logg
#   unit: log(cm.s**-2)
#   datatype: float32
#   description: '? Surface gravity from GSP-Phot Aeneas best library using BP/RP spectra (logg_gspphot)'
#   meta: !!omap
#   - {ucd: phys.gravity}
# - name: ap_[Fe/H]
#   datatype: float32
#   description: '? Iron abundance from GSP-Phot Aeneas best library using BP/RP spectra (mh_gspphot)'
#   meta: !!omap
#   - {ucd: phys.abund.Fe}
# - name: ap_A0
#   unit: mag
#   datatype: float32
#   description: '? Monochromatic extinction A0 at 547.7nm from GSP-Phot Aeneas best library using BP/RP spectra (azero_gspphot)'
#   meta: !!omap
#   - {ucd: phys.absorption;em.opt.V}
# - name: ap_b_A0
#   unit: mag
#   datatype: float32
#   description: '? Lower confidence level (16%) of monochromatic extinction A0 at 547.7nm from GSP-Phot Aeneas best library using BP/RP
#     spectra (azero_gspphot_lower)'
#   meta: !!omap
#   - {ucd: phys.absorption;em.opt.V;stat.min}
# - name: ap_B_A0
#   unit: mag
#   datatype: float32
#   description: '? Upper confidence level (84%) of monochromatic extinction A0 at 547.7nm from GSP-Phot Aeneas best library using BP/RP
#     spectra (azero_gspphot_upper)'
#   meta: !!omap
#   - {ucd: phys.absorption;em.opt.V;stat.max}
# - name: ap_AG
#   unit: mag
#   datatype: float32
#   description: '? Extinction in G band from GSP-Phot Aeneas best library using BP/RP spectra (ag_gspphot)'
#   meta: !!omap
#   - {ucd: phys.absorption}
# - name: ap_E(BP-RP)
#   unit: mag
#   datatype: float32
#   description: '? Reddening E(G_BP_-G_RP_) from GSP-Phot Aeneas best library using BP/RP spectra (ebpminrp_gspphot)'
#   meta: !!omap
#   - {ucd: stat.value;phot.color.excess;em.opt}
# - name: ap_Lib
#   datatype: string
#   description: Name of library that achieves the highest mean log-posterior in MCMC samples and was used to derive GSP-Phot parameters
#     in this table (libname_gspphot)
#   meta: !!omap
#   - {ucd: meta.record}
#   - {_votable_string_dtype: char}
#   - {_votable_arraysize: '*'}
#   subtype: json
# - name: ap_Teff-HS
#   unit: K
#   datatype: float64
#   description: '? Effective temperature from ESP-HS (teff_esphs)'
#   meta: !!omap
#   - {ucd: phys.temperature.effective}
# - name: ap_e_Teff-HS
#   unit: K
#   datatype: float64
#   description: '? Uncertainty at a 68% confidence level on the effective temperature from ESP-HS (teff_esphs_uncertainty)'
#   meta: !!omap
#   - {ucd: stat.error;phys.temperature.effective}
# - name: ap_A0-HS
#   unit: mag
#   datatype: float32
#   description: '? Monochromatic interstellar extinction (azero_esphs)'
#   meta: !!omap
#   - {ucd: phys.absorption;em.opt.V}
# - name: ap_e_A0-HS
#   unit: mag
#   datatype: float32
#   description: '? Uncertainty at a 68% confidence level on A_0_ from ESP-HS (azero_esphs_uncertainty)'
#   meta: !!omap
#   - {ucd: stat.error;phys.absorption;em.opt.V}
