# %ECSV 1.0
# ---
# datatype:
# - {name: sid, datatype: int64}
# - name: source_id
#   datatype: int64
#   description: Source Identifier
#   meta: !!omap
#   - {ucd: meta.id;meta.main}
# - name: teff_gspphot
#   unit: K
#   datatype: float32
#   description: Effective temperature from GSP-Phot Aeneas best library using BP/RP spectra
#   meta: !!omap
#   - {ucd: phys.temperature.effective}
# - name: teff_gspphot_lower
#   unit: K
#   datatype: float32
#   description: Lower confidence level (16%) of effective temperature from GSP-Phot Aeneas best library using BP/RP spectra
#   meta: !!omap
#   - {ucd: stat.value;phys.temperature.effective}
# - name: teff_gspphot_upper
#   unit: K
#   datatype: float32
#   description: Upper confidence level (84%) of effective temperature from GSP-Phot Aeneas best library using BP/RP spectra
#   meta: !!omap
#   - {ucd: stat.value;phys.temperature.effective}
# - name: logg_gspphot
#   unit: log(cm.s**-2)
#   datatype: float32
#   description: Surface gravity from GSP-Phot Aeneas best library using BP/RP spectra
#   meta: !!omap
#   - {ucd: phys.gravity}
# - name: mh_gspphot
#   unit: dex
#   datatype: float32
#   description: Iron abundance from GSP-Phot Aeneas best library using BP/RP spectra
#   meta: !!omap
#   - {ucd: phys.abund.Fe}
# - name: azero_gspphot
#   unit: mag
#   datatype: float32
#   description: Monochromatic extinction $A_0$ at 547.7nm from GSP-Phot Aeneas best library using BP/RP spectra
#   meta: !!omap
#   - {ucd: phys.absorption;em.opt.V}
# - name: ag_gspphot
#   unit: mag
#   datatype: float32
#   description: Extinction in G band from GSP-Phot Aeneas best library using BP/RP spectra
#   meta: !!omap
#   - {ucd: phys.absorption;em.opt}
# - name: ebpminrp_gspphot
#   unit: mag
#   datatype: float32
#   description: Reddening $E(G_{\rm BP} - G_{\rm RP})$ from GSP-Phot Aeneas best library using BP/RP spectra
#   meta: !!omap
#   - {ucd: phot.color.excess;em.opt}
# - name: distance_gspphot
#   unit: pc
#   datatype: float32
#   description: Distance from GSP-Phot Aeneas best library using BP/RP spectra
#   meta: !!omap
#   - {ucd: pos.distance}
# - name: libname_gspphot
#   datatype: string
#   description: Name of library that achieves the highest mean log-posterior in MCMC samples and was used to derive GSP-Phot parameters
#     in this table
#   meta: !!omap
#   - {ucd: meta.record}
#   - {_votable_string_dtype: char}
#   - {_votable_arraysize: '*'}
#   subtype: json
# - name: teff_esphs
#   unit: K
#   datatype: float32
#   description: Effective temperature from ESP-HS
#   meta: !!omap
#   - {ucd: phys.temperature.effective}
# - name: ag_esphs
#   unit: mag
#   datatype: float32
#   description: Intersterstellar extinction in G band from ESP-HS
#   meta: !!omap
#   - {ucd: phys.absorption;em.opt}
# - name: spectraltype_esphs
#   datatype: string
#   description: Spectral type from ESP-ELS
#   meta: !!omap
#   - {ucd: src.spType}
#   - {_votable_string_dtype: char}
#   - {_votable_arraysize: '*'}
#   subtype: json
# - name: teff_gspspec
#   unit: K
#   datatype: float32
#   description: Effective temperature from GSP-Spec MatisseGauguin using RVS spectra and Monte Carlo realisations
#   meta: !!omap
#   - {ucd: phys.temperature.effective;stat.median}
# - name: lum_flame
#   unit: solLum
#   datatype: float32
#   description: Luminosity of the star from FLAME using G band magnitude, extinction ({\tt agGspphot}),  parallax or distance, and a
#     bolometric correction {\tt bcFlame}
#   meta: !!omap
#   - {ucd: phys.luminosity}
# - name: classprob_dsc_combmod_star
#   datatype: float32
#   description: 'Probability from DSC-Combmod of being a single star (but not a white dwarf) (data used: BP/RP spectrum, photometry,
#     astrometry)'
#   meta: !!omap
#   - {ucd: stat.probability}
# - name: has_xp_continuous
#   datatype: bool
#   description: Flag indicating the availability of mean BP/RP spectrum in continuous representation for this source
#   meta: !!omap
#   - {ucd: meta.code.status}
# - name: phot_bp_rp_excess_factor
#   datatype: float32
#   description: BP/RP excess factor
#   meta: !!omap
#   - {ucd: arith.factor;phot.flux;em.opt}
# schema: astropy-2.0
