import pymc as pm

print(f"Running on PyMC v{pm.__version__}")
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np
from astropy.table import QTable
from scipy.stats import norm
%config InlineBackend.figure_format = 'retina'





KWS = QTable.read('KWS.dat',format='ascii')


selection_quality_KWS = ((KWS['Error'] < 0.05) & (KWS['Band'] == 'V'))
KWS = KWS[selection_quality_KWS]
data = KWS['Mag.']


with pm.Model() as model:
    # Prior distributions for the mixture components
    mu1 = pm.Uniform('mu1', lower=data.min(), upper=data.max())
    mu2 = pm.Uniform('mu2', lower=data.min(), upper=data.max())
    sigma1 = pm.HalfNormal('sigma1', sigma=1)
    sigma2 = pm.HalfNormal('sigma2', sigma=1)
    weights = pm.Dirichlet('weights', a=np.array([1, 1]))

    # Define the likelihood as a mixture of Gaussian components
    component1 = pm.Normal.dist(mu=mu1, sigma=sigma1)
    component2 = pm.Normal.dist(mu=mu2, sigma=sigma2)
    likelihood = pm.Mixture('likelihood', w=weights, comp_dists=[component1, component2], observed=data)


# Perform the Bayesian inference using the Metropolis-Hastings algorithm
with model:
    trace = pm.sample(200000, tune=20000,chains=6)



mu1_samples = trace.posterior['mu1']
mu2_samples = trace.posterior['mu2']
sigma1_samples = trace.posterior['sigma1']
sigma2_samples = trace.posterior['sigma2']
weights_samples = trace.posterior['weights']
weights_samples


mu1_mean = mu1_samples.mean().item()
mu2_mean = mu2_samples.mean().item()
sigma1_mean = sigma1_samples.mean().item()
sigma2_mean = sigma2_samples.mean().item()
mu1_mean,mu2_mean,sigma1_mean,sigma2_mean


