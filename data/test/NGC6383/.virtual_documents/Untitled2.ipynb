# Compute the mean values
mu1_mean = mu1_samples.mean()
mu2_mean = mu2_samples.mean()
sigma1_mean = sigma1_samples.mean()
sigma2_mean = sigma2_samples.mean()

# Create the figure and axes
fig, ax_mag = plt.subplots(figsize=(10, 6))

# Plot the Gaussian mixture model
x = np.linspace(0, 15, 200)
y = np.zeros_like(x)

for i in range(len(weights_samples)):
    y += weights_samples[i] * (
        np.exp(-0.5 * ((x - mu1_samples[i]) / sigma1_samples[i]) ** 2) / (np.sqrt(2 * np.pi) * sigma1_samples[i])
        + np.exp(-0.5 * ((x - mu2_samples[i]) / sigma2_samples[i]) ** 2) / (np.sqrt(2 * np.pi) * sigma2_samples[i])
    )

# Plot the Gaussian mixture
ax_mag.plot(x, y, 'k-', linewidth=2, label='Gaussian Mixture')

# Plot the individual Gaussian components
for i in range(len(weights_samples)):
    y_center = weights_samples[i] * np.exp(-0.5 * ((x - mu1_samples[i]) / sigma1_samples[i]) ** 2) / (
            np.sqrt(2 * np.pi) * sigma1_samples[i]
    )
    y_surround = weights_samples[i] * np.exp(-0.5 * ((x - mu2_samples[i]) / sigma2_samples[i]) ** 2) / (
            np.sqrt(2 * np.pi) * sigma2_samples[i]
    )

    ax_mag.plot(x, y_center, 'r--', alpha=0.1)
    ax_mag.plot(x, y_surround, 'b--', alpha=0.1)

# Plot the mean values
ax_mag.axvline(mu1_mean, color='r', linestyle='-', linewidth=2, label='mu1_mean')
ax_mag.axvline(mu2_mean, color='b', linestyle='-', linewidth=2, label='mu2_mean')

# Set plot labels and legend
ax_mag.set_xlabel('Magnitude')
ax_mag.set_ylabel('Density')
ax_mag.legend()

# Show the plot
plt.show()







































