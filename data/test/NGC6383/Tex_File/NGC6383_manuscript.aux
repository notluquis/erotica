\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Normalized cumulative counts of stars within NGC 6383 are plotted against radial distance from the cluster center for different brightness ranges, segmented into quartiles of $G_{\text  {mag}}$ from the brightest at 8.80 mag to the faintest at 20.66 mag. The green dashed line at $R_c = 1.94$ arcmin marks the core radius, and the red dashed line at $R_t = 40.71$ arcmin denotes the tidal radius, illustrating the spatial distribution of stars with varying brightness within these boundaries. See the text for more reference.}}{7}{figure.9}\protected@file@percent }
\newlabel{fig:cumulative_luminosity}{{9}{7}{Normalized cumulative counts of stars within NGC 6383 are plotted against radial distance from the cluster center for different brightness ranges, segmented into quartiles of $G_{\text {mag}}$ from the brightest at 8.80 mag to the faintest at 20.66 mag. The green dashed line at $R_c = 1.94$ arcmin marks the core radius, and the red dashed line at $R_t = 40.71$ arcmin denotes the tidal radius, illustrating the spatial distribution of stars with varying brightness within these boundaries. See the text for more reference}{figure.9}{}}
