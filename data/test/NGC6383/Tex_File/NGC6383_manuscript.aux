\@writefile{lof}{\contentsline {figure}{\numberline {A1}{\ignorespaces Cluster size variation as a function of minimum cluster size, determined through HDBSCAN clustering on proper motion data of sources. The blue line represents cluster sizes achieved at various minimum cluster sizes. The dashed blue line highlights the optimal minimum cluster size of 43, where the cluster size reaches a peak. The dashed green line indicates the maximum observed cluster size of 701.}}{13}{figure.A1.1}\protected@file@percent }
\newlabel{fig:min_cluster_size}{{A1}{13}{Cluster size variation as a function of minimum cluster size, determined through HDBSCAN clustering on proper motion data of sources. The blue line represents cluster sizes achieved at various minimum cluster sizes. The dashed blue line highlights the optimal minimum cluster size of 43, where the cluster size reaches a peak. The dashed green line indicates the maximum observed cluster size of 701}{figure.A1.1}{}}
